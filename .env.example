# MVP WebApp runtime contract
# Copy to .env only for local development. Never commit real values.

# DSH stays on loopback; the reverse proxy is the only public listener.
APP_HOST=127.0.0.1
PORT=3080

# Persist this path on a durable volume in preview/production.
DSH_HOME=/var/lib/dsh

# Public authority accepted by the DSH Host/Origin trust fence.
# Example only: app.example.com
PUBLIC_HOST=

# Outer single-user authentication at the reverse proxy.
PROXY_AUTH_USERNAME=
PROXY_AUTH_PASSWORD_HASH=

# Deployment automation only. Supply through GitHub/EdgeOne secret storage,
# never as a committed value.
EDGEONE_API_TOKEN=

# Model-provider credentials are provider-specific and must be injected through
# the deployment secret store after MVP-015 selects the Golden Path provider.
